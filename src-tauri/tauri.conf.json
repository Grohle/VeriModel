{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeriModel",
  "identifier": "io.verimodel.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VeriModel",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "IFC QA gate, quantity takeoff and BCF export",
    "longDescription": "VeriModel checks an IFC model against rules and IDS requirements, produces a quantity takeoff with optional cost estimate, and exports BCF issues, all offline on your computer.",
    "copyright": "Copyright 2026 Grohle. PolyForm Noncommercial 1.0.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../examples/": "examples/",
      "../tests/fixtures/*.ifc": "fixtures/"
    }
  }
}
